# ═══════════════════════════════════════════════════════════════════════════
# OpenD systemd unit — 本番で使っている形(2026-10-24 導入・OpenD 10.11.7108)。
# 置き場: /etc/systemd/system/opend.service(本番反映は手で、確認しながら)
#
# 仕組み:
#   OpenD 10.10 から、設定ファイル(OpenD.xml)にアカウントとパスワードを書けなくなった。
#   代わりに、一度だけ手でログインして「パスワードを記憶する(Y)」を選ぶと、次からは
#   -login_by_remember=1 でパスワード無しにログインできる。このユニットはそれを使う。
#   パスワードは、このファイルにも、起動の引数にも、環境変数にも書かない。
#
#   ログインID だけは /etc/opend.env(root:root・600)に1行で置く:
#     OPEND_ACCOUNT=<moomoo のログインID>
#   EnvironmentFile= で読むので、`systemctl cat opend` にも ID は出ない。
#
#   OpenD は対話の画面(コンソール)を持つので、screen -DmS の中で動かす。
#   -D: screen 自身は前に残る(Type=simple で systemd が見張れる)
#   中の様子: `screen -r opend`(抜ける時は Ctrl+A → D。Ctrl+C は効かない)
#
# 導入手順(すべて手で・確認しながら):
#   1. 新しい OpenD を展開し、OpenD.xml の ip / api_port=11111 / telnet_ip=127.0.0.1 /
#      telnet_port=22222 を有効にする(telnet の2行は配布時に <!-- --> で無効になっている)
#   2. screen の中で ./OpenD を起動し、手でログインして「記憶する」に Y
#      (図形/SMS認証が出たら bridge/README.md の手順)
#   3. ./OpenD -login_account=<ID> -login_by_remember=1 でパスワード無しに入れることを確かめる
#   4. /etc/opend.env を作る(上記)・このファイルを /etc/systemd/system/opend.service へ
#   5. sudo systemctl daemon-reload && sudo systemctl enable --now opend
#   6. bridge/scripts/check_opend_status.sh と check_reboot_readiness.sh で確認
#   7. 古い手動起動の OpenD が残っていないこと(OpenD の重複は 7/3 の障害の一因)
#
# 失敗時の再試行は 1時間に3回まで(StartLimitBurst)。ログインの失敗を繰り返して
# moomoo の側でアカウントが止められないようにするため。
#
# 残存リスク(正直に):
#   - 記憶したパスワード(ログインの鍵)は ~/.com.moomoo.OpenD/ の中に保存される。
#     このホストの ubuntu / root ユーザーはそれを使ってログインできる。SSH の入口が境界。
#   - 記憶には期限がある(moomoo の公式 FAQ)。切れると自動ログインに失敗する。その時は
#     手順2〜3をやり直す(ブリッジの状態の openDStatus で気づける)。
#   - API と telnet は 127.0.0.1 だけで待ち受ける(インターネットに出さない)。
#
# 履歴: 10.8.6818(2026-07〜10)は screen の中で手で起動し、パスワードを起動の引数で
#   渡していた。このユニットはそれを置き換えた。
# ═══════════════════════════════════════════════════════════════════════════
[Unit]
Description=moomoo OpenD (localhost only) for ARGUS bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
# 版を上げた時は、ここのディレクトリを差し替える。
WorkingDirectory=/home/ubuntu/opend_10.11.7108/moomoo_OpenD_10.11.7108_Ubuntu18.04/moomoo_OpenD_10.11.7108_Ubuntu18.04
EnvironmentFile=/etc/opend.env
ExecStart=/usr/bin/screen -DmS opend ./OpenD -login_account=${OPEND_ACCOUNT} -login_by_remember=1
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
