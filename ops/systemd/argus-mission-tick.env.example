# Non-secret service settings. ARGUS_ADMIN_TOKEN is inherited from the existing
# root-owned /etc/argus-bridge.env and must never be placed on a command line.
ARGUS_BACKEND_URL=https://argus-backend-3j2m.onrender.com
ARGUS_TICK_TIMEOUT_SECONDS=180
ARGUS_TICK_MAX_ATTEMPTS=2
ARGUS_TICK_MAX_BATCHES=3
ARGUS_TICK_TOTAL_BUDGET_SECONDS=240
# Only a release verified in production is trusted. GitHub main and backend
# /healthz are never self-authorizing inputs.
ARGUS_PRODUCTION_RELEASE_MANIFEST_URL=https://raw.githubusercontent.com/mitsugue/argus/production-release/production/argus-backend.json
# Deprecated compatibility placeholder. The resolver deliberately ignores this
# moving-ref input; keep it empty until every installed unit has migrated.
ARGUS_TRUSTED_BUILD_REF_URL=
ARGUS_BUILD_TRANSITION_GRACE_SECONDS=900
ARGUS_BUILD_IDENTITY_TIMEOUT_SECONDS=15
ARGUS_BUILD_IDENTITY_MAX_ATTEMPTS=2
ARGUS_BUILD_IDENTITY_STATE_FILE=/var/lib/argus-build-identity/state.json
ARGUS_BUILD_IDENTITY_DECISION_FILE=/run/argus-build-identity/decision.json
# First-install/emergency bootstrap only. Remove after manifest fetch, exact
# match, and lastVerifiedSha persistence are all verified read-only.
ARGUS_EXPECTED_BUILD_SHA=
